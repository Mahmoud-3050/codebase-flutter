# frozen_string_literal: true

require_relative '../shared/load_deploy_config'
require_relative '../shared/flutter_build'
require_relative '../shared/flutter_version'
require_relative '../shared/prepare_version'
require_relative '../shared/pre_build'
require 'shellwords'

DeployConfig.load!

default_platform(:ios)

platform :ios do
  desc 'Read store versions and write the next version into pubspec.yaml'
  lane :prepare_version do
    if DeployConfig.truthy?('DRY_RUN')
      UI.important('DRY_RUN: skipping store version lookup')
      next
    end
    PrepareVersion.run(self)
  end

  desc 'Build an IPA and upload it to TestFlight'
  lane :deploy do
    if DeployConfig.truthy?('DRY_RUN')
      UI.important('DRY_RUN: skipping iOS archive and TestFlight upload')
      next
    end
    PreBuild.run!(self, platform: 'ios')

    Dir.chdir(DeployConfig::ROOT) do
      sh(Shellwords.join(['flutter', 'build', 'ios', '--release', '--config-only', *FlutterBuild.build_arg_list]))
    end

    app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_filepath: DeployConfig.secret_path(ENV.fetch('ASC_KEY_PATH')),
      in_house: false
    )

    # Signing uses the Apple ID already logged into Xcode — no Match, no
    # extra certs repo. -allowProvisioningUpdates lets xcodebuild refresh
    # the App Store distribution profile from the developer portal.
    automatic_code_signing(
      path: 'Runner.xcodeproj',
      use_automatic_signing: true,
      team_id: ENV.fetch('IOS_TEAM_ID')
    )

    build_app(
      workspace: 'Runner.xcworkspace',
      scheme: FlutterBuild.ios_scheme,
      configuration: FlutterBuild.ios_configuration,
      export_method: 'app-store',
      export_team_id: ENV.fetch('IOS_TEAM_ID'),
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{ENV.fetch('IOS_TEAM_ID')}",
      export_options: {
        method: 'app-store',
        signingStyle: 'automatic',
        teamID: ENV.fetch('IOS_TEAM_ID')
      }
    )

    groups = ENV.fetch('TESTFLIGHT_GROUPS', '').split(',').map(&:strip).reject(&:empty?)
    testflight_args = { skip_waiting_for_build_processing: groups.empty? }
    if groups.any?
      testflight_args[:distribute_external] = true
      testflight_args[:groups] = groups
    end
    upload_to_testflight(**testflight_args)
  end
end
