# frozen_string_literal: true

require_relative '../shared/load_deploy_config'
require_relative '../shared/flutter_build'
require_relative '../shared/flutter_version'
require_relative '../shared/prepare_version'
require_relative '../shared/pre_build'

DeployConfig.load!

default_platform(:ios)

platform :ios do
  desc 'Read store versions and write the next version into pubspec.yaml'
  lane :prepare_version do
    if DeployConfig.truthy?('DRY_RUN')
      UI.important('DRY_RUN: skipping store version lookup')
      next
    end
    PrepareVersion.run(self)
  end

  desc 'Build an IPA and upload it to TestFlight (upload skipped when SKIP_DEPLOY)'
  lane :deploy do
    if DeployConfig.truthy?('DRY_RUN')
      UI.important('DRY_RUN: skipping iOS archive and TestFlight upload')
      next
    end
    ipa = FlutterBuild.existing_ipa_path
    if ipa && FlutterBuild.skip_compile?(ipa)
      UI.important("SKIP_BUILD_IF_EXISTS: using existing IPA #{ipa}")
    else
      PreBuild.run!(self, platform: 'ios')
      FlutterBuild.clean_darwin_ephemeral!

      # Signing uses the Apple ID already logged into Xcode — no Match.
      # flutter build ipa passes -allowProvisioningUpdates to xcodebuild.
      automatic_code_signing(
        path: DeployConfig.project_path('ios', 'Runner.xcodeproj'),
        use_automatic_signing: true,
        team_id: ENV.fetch('IOS_TEAM_ID')
      )

      FlutterBuild.run_flutter!(self, *FlutterBuild.ios_flutter_args)
      ipa = FlutterBuild.existing_ipa_path
    end

    UI.user_error!("IPA not found under #{FlutterBuild.ipa_dir} (or release/Runner.ipa)") if ipa.nil? || !File.file?(ipa)

    if DeployConfig.truthy?('SKIP_DEPLOY')
      UI.success("SKIP_DEPLOY: IPA ready at #{ipa} (TestFlight upload skipped)")
      next
    end

    app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_filepath: DeployConfig.secret_path(ENV.fetch('ASC_KEY_PATH')),
      in_house: false
    )

    groups = ENV.fetch('TESTFLIGHT_GROUPS', '').split(',').map(&:strip).reject(&:empty?)
    testflight_args = {
      ipa: ipa,
      skip_waiting_for_build_processing: groups.empty?
    }
    if groups.any?
      testflight_args[:distribute_external] = true
      testflight_args[:groups] = groups
    end
    upload_to_testflight(**testflight_args)
  end
end
