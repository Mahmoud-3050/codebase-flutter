{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "dev",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_dev.dart",
      "args": [
        "--flavor",
        "dev",
        "--dart-define=GOOGLE_SERVER_CLIENT_ID=${env:GOOGLE_SERVER_CLIENT_ID}"
      ]
    },
    {
      "name": "dev (trust bad certs)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_dev.dart",
      "args": [
        "--flavor",
        "dev",
        "--dart-define=TRUST_BAD_CERTIFICATES=true",
        "--dart-define=GOOGLE_SERVER_CLIENT_ID=${env:GOOGLE_SERVER_CLIENT_ID}"
      ]
    },
    {
      "name": "live",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_live.dart",
      "args": [
        "--flavor",
        "live",
        "--dart-define=GOOGLE_SERVER_CLIENT_ID=${env:GOOGLE_SERVER_CLIENT_ID}"
      ]
    }
  ]
}
